# Copy to .env and fill in these four. Nothing else is required.
REVIEWMEH_SG_URL=https://yoursite.shotgrid.autodesk.com
REVIEWMEH_SG_SCRIPT_NAME=reviewmeh
REVIEWMEH_SG_SCRIPT_KEY=
# The address people will use. Links and ShotGrid's menu buttons are built from it.
REVIEWMEH_PUBLIC_URL=http://your-server:8086

# Optional. `reviewmeh check` tells you if your site needs any of these.
# The ShotGrid permission groups that run ReviewMeh, if not Admin:
# REVIEWMEH_ADMIN_GROUP=Admin
# What groups shots into a cut. Each project uses the first its shots are linked to.
# If you use scenes rather than sequences, use scene, or episode,scene. "off" for no cuts:
# REVIEWMEH_CUT_BY=episode,sequence
# Shot statuses left out of cuts:
# REVIEWMEH_SCHEMA_OMIT_STATUS=omt
# Behind a reverse proxy, its address:
# REVIEWMEH_SERVER_FORWARDED_ALLOW_IPS=172.18.0.2
